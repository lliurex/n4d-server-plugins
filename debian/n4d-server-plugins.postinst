#!/bin/sh

set -e
case "$1" in
   configure)

        if dpkg --compare-versions "$2" lt 0.231; then
                systemctl restart dnsmasq || true

        fi
	   
	systemctl stop n4d || true
	systemctl start n4d || true
	
   ;;

   abort-upgrade|abort-remove|abort-deconfigure)
   ;;

   *)
       exit 1
   ;;
esac

#DEBHELPER#

exit 0

